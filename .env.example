# Bu dosyayı .env olarak kopyalayın. Göreli yollar proje köküne göredir.

# Veritabanı
DB_PATH=data/film.duckdb

# Sunucu (yalnızca bu PC'den erişim)
APP_HOST=127.0.0.1
APP_PORT=8000

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen3:8b

# TMDB (v4 Bearer tercih edilir, v3 anahtar yedektir)
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Katalog filtreleri (1.0 ≈ 198 bin aday, 30 istek/sn ile yaklaşık 2 saat)
TMDB_MIN_POPULARITY=1.0
TMDB_MIN_VOTES=20
